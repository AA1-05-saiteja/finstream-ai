# ==========================================
# FinStream AI - Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=FinStream AI

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_TOPIC_ALERTS=transaction_alerts
KAFKA_CONSUMER_GROUP=finstream-stream-processors
KAFKA_AUTO_OFFSET_RESET=latest

# Synthetic Transaction Generator
GENERATOR_RATE_TPS=5
GENERATOR_SUSPICIOUS_PROBABILITY=0.08
GENERATOR_ACCOUNTS_POOL=200
GENERATOR_MERCHANTS_POOL=50
GENERATOR_DEVICES_POOL=300

# PostgreSQL Database Configuration
POSTGRES_USER=finstream_user
POSTGRES_PASSWORD=finstream_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finstream_db
DATABASE_URL=postgresql+psycopg2://finstream_user:finstream_password@localhost:5432/finstream_db

# Redis Configuration (Real-Time State & Features)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TRANSACTION_TTL_SECONDS=3600
REDIS_RISK_TTL_SECONDS=86400

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Machine Learning & Risk Thresholds
MODEL_DIR=models/saved
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_HIGH=0.70
XGBOOST_MODEL_PATH=models/saved/xgboost_model.joblib
ISOLATION_FOREST_PATH=models/saved/isolation_forest.joblib
SCALER_PATH=models/saved/scaler.joblib
FEATURE_COLUMNS_PATH=models/saved/feature_columns.json
